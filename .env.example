# Copy this file to ".env"
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# You normally DON'T need to edit this by hand — `npm run setup` fills it in.

# The address of your local Hermes agent's API server.
# Leave this as-is unless you changed Hermes's port.
HERMES_API_URL=http://127.0.0.1:8642/v1

# The secret key the web app uses to talk to your local Hermes.
# `npm run setup` generates one and puts the SAME value in Hermes's own
# config (~/.hermes/.env), so the two can talk. If you're setting up by
# hand, paste the same key in both places.
API_SERVER_KEY=

# Optional: change the port the web app runs on (default is 3000).
# PORT=3000
